#!/usr/bin/env bash
# runnerctl: manage projects on the runner control plane.
#   runnerctl apply <compose.yml> [name] [--now]  add or update a project (name defaults to the file name);
#                                                 --now skips the one-machine-at-a-time rollout
#   runnerctl get <name>                          print a project's compose file
#   runnerctl rm <name>                           remove a project from every machine
#   runnerctl status                              projects and machines
#   runnerctl roll [machine]                      replace machines one at a time (e.g. after an agent change)
#   runnerctl machines <n>                        how many machines to keep running
# The admin token comes from $RUNNER_TOKEN or ~/.config/runnerctl/token.
set -euo pipefail
URL=${RUNNER_URL:-https://control.billybishop4-workers.xyz}
TOKEN=${RUNNER_TOKEN:-$(cat ~/.config/runnerctl/token 2>/dev/null || true)}
api() { curl -sS -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' "$URL/api$1" "${@:2}"; }
usage() { sed -n '2,10p' "$0" | sed -E 's/^# ?//'; exit 1; }

cmd=${1:-}
shift || true
case "$cmd" in
  apply)
    [ $# -ge 1 ] || usage
    file=$1; shift
    name="" now=""
    for a in "$@"; do case $a in --now) now="?now=1" ;; *) name=$a ;; esac; done
    name=${name:-$(basename "${file%.*}")}
    # The port to put online comes from the file's x-runner block (docker compose ignores x- keys).
    body=$(python3 - "$file" <<'PY'
import json, sys, yaml
text = open(sys.argv[1]).read()
doc = yaml.safe_load(text)
if not isinstance(doc, dict) or not isinstance(doc.get("services"), dict):
    sys.exit("not a docker compose file (no services:)")
print(json.dumps({"compose": text, "port": (doc.get("x-runner") or {}).get("port")}))
PY
)
    api "/projects/$name$now" -X PUT --data-binary "$body" | jq . ;;
  get) [ $# -eq 1 ] || usage; api "/projects/$1" | jq -r '.compose // .' ;;
  rm) [ $# -eq 1 ] || usage; api "/projects/$1" -X DELETE | jq . ;;
  status | ls)
    curl -sS "$URL/api/status" | jq -r '
      "Projects:",
      (.projects[] | "  \(.name)  v\(.version)  \(.state)"
        + (if .state == "rolling out" then " (\(.rollout)/\(.machines))" else "" end)
        + (if .halted then "\n    \(.halted)" else "" end)),
      "Machines: \([.runs[] | select(.live and (.retiring | not)) | .machine] | unique | length) of \(.machines) up",
      (.runs[] | "  #\(.machine)  run \(.id)  "
        + (if (.live | not) then "gone" elif .retiring then "leaving" elif .handover then "starting its replacement"
           elif .ready then "online" else "starting" end)
        + "  " + ([.projects | to_entries[] | "\(.key) v\(.value.v) \(.value.s)"] | join(", ")))' ;;
  roll) api "/roll${1:+?machine=$1}" -X POST | jq . ;;
  machines) [ $# -eq 1 ] || usage; api /settings -X PUT -d "{\"machines\": $1}" | jq . ;;
  *) usage ;;
esac
